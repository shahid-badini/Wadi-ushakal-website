{
  // `npm run dev` as a VS Code task. F5 (see launch.json) starts it first, then opens Chrome.
  "version": "2.0.0",
  "tasks": [
    {
      // Starts when the folder is opened: rebuilds dist/ on every save, so "Go Live" always shows the latest site
      "label": "Wadi Nushakal: auto build",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Wadi Nushakal: dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      // Chrome is opened by the debugger, so stop Vite opening a second browser tab
      "options": { "env": { "BROWSER": "none" } },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "a^" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
